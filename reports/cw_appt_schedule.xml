      <select canParse="no">
      <![CDATA[select 'Dr. ' || d.first_name || ' ' || d.last_name doctor,
       to_char(a.appt_start, 'Dy DD-Mon HH24:MI') start_time,
       p.mrn, p.first_name || ' ' || p.last_name patient,
       a.reason, a.status
from   appointments a
       join doctors d  on d.doctor_id = a.doctor_id
       join patients p on p.patient_id = a.patient_id
where  a.appt_start >= to_date(:p_from, 'YYYY-MM-DD')
and    a.appt_start <  to_date(:p_to, 'YYYY-MM-DD') + 1
order  by d.last_name, d.first_name, a.appt_start]]>
